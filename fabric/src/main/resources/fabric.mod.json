  "mixins": [
    "immersive_snow_reloaded.mixins.json"
  ],
  "depends": {
    "fabric": ">=${fabricVersion}",
    "minecraft": "${minecraftVersion}",
    "fabric-api": "*"
  },
  "recommends": {
    "snowrealmagic": "*",
    "sereneseasons": "*",
    "seasons": "*",
    "vanillabackport": "*"
  }
